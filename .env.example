# ─────────────────────────────────────────────────────────────
#  EmailJS Configuration
#  Copy this file to .env and fill in your actual values.
#  Then add these same keys in Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# 1. Go to https://www.emailjs.com → Account → API Keys
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# 2. Go to EmailJS → Email Services → your service → Service ID
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here

# 3. Go to EmailJS → Email Templates → your template → Template ID
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
